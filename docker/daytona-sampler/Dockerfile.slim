# Daytona snapshot of the vLLM ROCm sampler, slimmed under Daytona's 20 GB snapshot cap.
#
# docker/daytona-sampler/Dockerfile builds to 27.6 GB, which Daytona refuses ("Snapshot size
# exceeds maximum allowed size of 20GB"). This variant keeps the same pinned base and
# additions, then removes what an MI355X (gfx950) sampler never loads: kernel files of other
# GPU archs, the duplicate aiter under the system site-packages (the runtime venv has its own),
# cupy, static libraries and caches. The pruned tree is copied onto an empty image (one
# layer: deleting files in a later layer would not shrink the snapshot), so every ENV of the
# base is restated below. The build fails unless triton (amd + nvidia backends), torch,
# vllm, aiter, the sampler's modules and awscli import. About 15 GB.
# Verified 2026-11-15: builds on Daytona (15.1 GB). A sandbox without a GPU cannot run
# `vllm serve --help` (the unpruned base fails the same way: "Failed to infer device type").
FROM docker.io/vllm/vllm-openai-rocm@sha256:5f47cc1004d9a7ac65f8a913725edb20c62c99a07e31cbf4ba21741bd0b4f9b1 AS full

ARG DOCKER_CLI_VERSION=29.0.2
ARG COMPOSE_VERSION=2.40.3

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      openssh-client curl ca-certificates procps iproute2 tar util-linux \
 && rm -rf /var/lib/apt/lists/*

# the sampler's imports the base may lack, and awscli, in the runtime venv
RUN /opt/runtime-venv/bin/python3 -m pip install --no-cache-dir \
      "boto3>=1.34" "safetensors>=0.4" "zstandard>=0.22" "httpx>=0.27" "awscli>=1.33" \
 && ln -sf /opt/runtime-venv/bin/aws /usr/local/bin/aws

RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar xz --strip-components=1 -C /usr/local/bin docker/docker \
 && mkdir -p /usr/local/lib/docker/cli-plugins \
 && curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
      "https://github.com/docker/compose/releases/download/v${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
 && chmod 755 /usr/local/bin/docker /usr/local/lib/docker/cli-plugins/docker-compose

RUN mkdir -p /work /models /tunnel && chmod 1777 /work /models && chmod 700 /tunnel
# prune for Daytona's 20 GB snapshot cap (MI355X = gfx950 only; CUDA-only and duplicate packages)
RUN set -x; D=/usr/local/lib/python3.12/dist-packages; V=/opt/runtime-venv/lib/python3.12/site-packages; \
    /opt/runtime-venv/bin/python3 -c "import aiter,sys;print('AITER_FROM',aiter.__file__)" || true; \
    if [ -d $V/aiter ]; then rm -rf $D/aiter $D/aiter_meta; fi; \
    rm -rf $D/cupy $D/cupy_backends $V/aiter/jit/flydsl_cache /root/.cache /tmp/* /usr/share/doc /var/cache/apt; \
    find $D/_rocm_sdk_libraries $D/_rocm_sdk_core $D/_rocm_sdk_devel $D/torch $V/aiter -depth -name '*gfx*' ! -name '*gfx950*' ! -name '*gfx9-*' ! -name '*gfx9_*' -exec rm -rf {} + ; \
    find / -xdev -path /proc -prune -o -type f -name '*.a' -path '*_rocm_sdk*' -print -delete >/dev/null; \
    du -xh -d2 $D | sort -h | tail -12; du -sxh /; \
    echo YETO_IMAGE_CHECK; cd /tmp && /opt/runtime-venv/bin/python3 -c "import triton, triton.backends, triton.backends.nvidia, triton.backends.amd; print('triton', triton.__version__, sorted(triton.backends.backends))" \
    && /opt/runtime-venv/bin/python3 -c "import torch, vllm, aiter, boto3, safetensors, zstandard, httpx, numpy; from vllm.model_executor.models.qwen3 import Qwen3ForCausalLM; print('torch', torch.__version__, torch.version.hip, 'vllm', vllm.__version__)" \
    && aws --version && echo YETO_IMAGE_CHECK_OK
FROM scratch
COPY --from=full / /
ENV AITER_ROCM_ARCH="gfx942;gfx950"
ENV CCACHE_COMPILERCHECK="content"
ENV CCACHE_DIR="/root/.cache/ccache"
ENV HIP_CLANG_PATH="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel/lib/llvm/bin"
ENV HIP_DEVICE_LIB_PATH="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_core/lib/llvm/amdgcn/bitcode"
ENV HIP_FORCE_DEV_KERNARG="1"
ENV HIP_PATH="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel"
ENV HSA_ENABLE_IPC_MODE_LEGACY="1"
ENV HSA_NO_SCRATCH_RECLAIM="1"
ENV KINETO_CONFIG="/app/libkineto.conf"
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel/lib:/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel/lib/rocm_sysdeps/lib:/usr/local/lib/python3.12/dist-packages/_rocm_sdk_core/lib:/usr/local/lib/python3.12/dist-packages/_rocm_sdk_core/lib/rocm_sysdeps/lib"
ENV MIOPEN_DEBUG_CONV_DIRECT="0"
ENV MIOPEN_DEBUG_CONV_GEMM="0"
ENV PATH="/opt/runtime-venv/bin:/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel/bin:/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel/lib/llvm/bin:/usr/local/lib/python3.12/dist-packages/_rocm_sdk_core/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV PYTHON_VERSION="3.12"
ENV PYTHONNOUSERSITE="1"
ENV PYTORCH_NVML_BASED_CUDA_CHECK="1"
ENV PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx950;gfx1100;gfx1101;gfx1200;gfx1201;gfx1150;gfx1151"
ENV ROCM_HOME="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel"
ENV ROCM_PATH="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel"
ENV ROCPROFILER_QUEUE_INTERPOSITION="0"
ENV ROCSHMEM_DIR="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel"
ENV SAFETENSORS_FAST_GPU="1"
ENV SDK_CORE="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_core"
ENV SDK_DEV="/usr/local/lib/python3.12/dist-packages/_rocm_sdk_devel"
ENV SITE_PACKAGES="/usr/local/lib/python3.12/dist-packages"
ENV TOKENIZERS_PARALLELISM="false"
ENV UCX_ROCM_COPY_SIGPOOL_MAX_ELEMS="inf"
ENV UCX_ROCM_IPC_SIGPOOL_MAX_ELEMS="inf"
ENV UV_HTTP_TIMEOUT="500"
ENV UV_INDEX_STRATEGY="unsafe-best-match"
ENV UV_LINK_MODE="copy"
ENV PYTHONUNBUFFERED=1
CMD ["sleep", "infinity"]
