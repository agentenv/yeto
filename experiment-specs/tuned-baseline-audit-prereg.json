  "thesis": {
    "hypothesis": "Fixed-eta baselines can create or exaggerate claimed outer-optimizer effects; independent per-arm LR tuning with paired seeds will often attenuate or collapse them.",
    "primary_object": "independently tuned mu=0 endpoint loss versus communication horizon/communication cost",
    "mechanistic_residual": "curvature-weighted second-order buffer energy after first-order step calibration",
    "outcome_neutral": true
  },
  "estimands": {
    "fixed": "L(method,H,eta_pub,s)-L(baseline,H,eta_pub,s)",
    "tuned": "min_eta L(method,H,eta,s)-min_eta L(baseline,H,eta,s)",
    "frontier": "min_eta L(mu=0,H,eta)",
    "negative_delta_favors_method": true
  },
  "classification": {
    "FIXED_NOT_REPLICATED": "fixed sign wrong or Holm-adjusted seed-level 95% CI includes zero",
    "COLLAPSES_WITH_TUNING": "fixed effect replicates and tuned CI is wholly inside the stack equivalence interval",
    "SURVIVES_TUNING": "fixed effect replicates, tuned CI excludes zero in the published direction, and absolute tuned mean is at least epsilon",
    "REVERSES_WITH_TUNING": "fixed effect replicates and tuned CI excludes zero in the opposite direction",
    "ATTENUATED_OR_INCONCLUSIVE": "none of the other classifications applies"
  },
