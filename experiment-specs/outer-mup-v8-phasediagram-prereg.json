    "momentum_transfer": {
      "code_true_term": "the raw -log2(1-mu^(T+1)) term is the exact final-step Nesterov transient 1/(1-mu^(T+1)); residual coefficients are the frozen Theory Lane C v3/v4-era measured surface",
      "coordinates": {
        "h": "log2(H/512)=0 in v8",
