{
  "analysis_contract": {
    "bootstrap": {
      "method": "paired nonparametric training-seed bootstrap refitting all curves",
      "minimum_valid_complete_refits": 9500,
      "pointwise_interval": 0.95,
      "replicates": 10000,
      "rng_seed": 20260728,
      "simultaneous_interval": "95th percentile of the valid-draw maximum absolute deviation across all 40 Delta estimates; one common unstudentized radius"
    },
    "curve_estimator": {
      "coordinate": "x=log2(eta)",
      "eta_star": "2^(-b/(2a))",
      "formula": "loss=a*x^2+b*x+c fit by OLS to the four five-seed mean losses",
      "interior_rule": "a>0 and min(grid)+1e-12 < -b/(2a) < max(grid)-1e-12",
      "tuned_optimum_loss": "c-b^2/(4a)",
      "unbracketed_rule": "nonpositive curvature or a boundary/outside vertex is UNBRACKETED; no point may be dropped"
    },
    "descriptive_outputs": [
      "pointwise paired 95% CIs and pointwise labels",
      "eta_star and fitted tuned loss for every curve",
      "raw-minus-corrected tuned-loss contrast may be reported descriptively but is not a registered phase label"
    ],
    "full_quorum": "the diagram gate is evaluable only with all 900 cells, all 45 point fits interior, and at least 9500 valid complete shared-bootstrap refits",
    "pairing": "one shared five-index training-seed resample is applied to all 45 curves in every bootstrap draw",
    "practical_margin_loss": 0.01,
    "primary_estimand": "Delta(T,mu,arm)=fitted tuned-optimum loss(T,mu,arm)-fitted tuned-optimum loss(T,mu0), separately for raw and corrected",
    "primary_phase_labels": {
      "HELPS": "simultaneous 95% CI high < -0.01",
      "HURTS": "simultaneous 95% CI low > +0.01",
      "NEUTRAL": "simultaneous 95% CI is wholly inside [-0.01,+0.01]",
      "NOT_EVALUABLE": "missing/invalid/nonfinite work, any point curve unbracketed, or fewer than 9500 valid complete refits",
      "UNCERTAIN": "evaluable simultaneous CI satisfies none of HELPS/HURTS/NEUTRAL"
    }
  },
  "authority": {
    "all_amendments_require_new_commit_and_refreshed_hashes": true,
    "contract_kind": "prospective code, execution, and analysis contract",
    "fleet_owner": "outer-mup-v6-factorial until every v6 slot queue is drained and a fresh loss-blind drain proof passes",
    "launch_forbidden_at_registration": true,
    "launch_requires_clean_pushed_registration_commit": true,
    "outcome_aware_recenter_extension_or_cell_substitution_forbidden": true,
    "prior_records_immutable": "v1-v6 registrations, results, sealed readouts, manifests, and notes are read-only to v8",
    "registration_files": [
      "experiment-specs/outer-mup-v8-phasediagram-prereg.json",
      "experiment-specs/outer-mup-v8-phasediagram-prereg.md"
    ],
    "unregistered_cell_launch_forbidden": true
  },
  "center_models": {
    "eta0": {
      "T40_exception": {
        "reason": "v3 T40 mu0 loss was still decreasing at its high edge; one pre-outcome registered rung above that measured boundary prevents knowingly repeating the miss",
