  "analysis_contract": {
    "D_definition": "D_obs(T)=[eta_star(mu=0.9,T)/eta_star(mu=0,T)]/(1-0.9)",
    "bootstrap": {
      "coordinate": "log2_D_T5_minus_log2_D_T20",
      "minimum_valid_interior_refits": 9500,
      "method": "paired nonparametric training-seed curve bootstrap; one shared three-index resample is applied to all four curves and all quadratics are refit",
      "replicates": 10000,
      "rng_seed": 20260726
    },
    "eta_star_estimator": {
      "boundary_tolerance_log2": 1e-12,
      "coordinate": "x=log2(eta)",
      "curve": "loss=a*x^2+b*x+c fitted to the four exact registered eta values using the three-seed mean at each eta",
      "interior_rule": "a>0 and min(grid)+1e-12 < -b/(2a) < max(grid)-1e-12",
      "unbracketed_rule": "nonpositive curvature or boundary/outside vertex is UNBRACKETED"
    },
    "gate_G4": {
      "bands_interpretation": "wide bands mean the same finite-horizon law regime as 135M, not exact-constant replication",
      "conditions_all_required": [
        "both pooled mu=0.9 optima are interior; both mu=0 optima are additionally required to define D",
        "D_obs(T=5) in [1.7,3.2] inclusive",
        "D_obs(T=20) in [0.8,1.5] inclusive",
        "paired 95% bootstrap CI for log2 D(T=5)-log2 D(T=20) has lower endpoint > 0"
      ],
      "failure_rule": "complete bracketed evidence that violates any condition is FAIL",
      "not_evaluable_rule": "missing/invalid cell evidence, any ratio-required pooled unbracketed optimum, or fewer than 9500 valid bootstrap refits is NOT_EVALUABLE",
      "verdicts": [
        "PASS",
        "FAIL",
        "NOT_EVALUABLE"
      ]
    },
    "output": {
      "note_line": "G4 VERDICT: <PASS|FAIL|NOT_EVALUABLE> D5=<value|NA> D20=<value|NA>",
