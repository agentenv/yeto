__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
checkpoints/
runs/
logs/
*.log
.env
wandb/
syncer/target/
.yeto_loss.pkl
.yeto_loss.*.pkl
# Default output directories of the comparison, smoke and benchmark scripts.
compare-work/
compare-report/
smoke-report/
lm-benchmark-probes/
# Local run directories (Modal app/call ids, pulled tapes) stay outside the repo.
/s1-runs/
.claude/

# Personal drafts, translations, diagrams and scratch builds stay local:
# keep them under drafts/ or scratch/ (or name them *.zh.md / *_ZH.md).
drafts/
scratch/
diagrams/
*_ZH.md
*.zh.md
.*-build/

# Specs, run evidence, run logs and reports stay outside the repository.
/openspec/
/evidence*/
**/run-logs/

# Run logs never enter the repository. These rules come last so no earlier
# `!` re-includes logs.
**/run-logs/**
*.log
*.stderr
*.stdout
*metrics*.json
.g1-build/
