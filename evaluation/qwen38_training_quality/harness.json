{
  "compose": "services:\n  main:\n    extra_hosts:\n      - host.docker.internal:host-gateway\n    volumes:\n      - $REMOTE_ROOT/runtime/qwen38-codex-models.json:/etc/dressage/qwen38-codex-models.json:ro\n",
  "contains_model_responses": false,
  "contains_original_benchmark_tasks": false,
  "integration": {
    "agent_protocol_overrides": {
      "codex": "openai"
    },
    "artifacts": {
      "dir_mode": 448,
      "file_mode": 384,
      "fsync": true,
      "mode": "both",
      "root": "$REMOTE_ROOT/gateway-artifacts"
    },
    "backend": {
      "dressage_proxy_url": "http://127.0.0.1:35810",
      "router_api_path": "/v1",
      "service_api_key_env": "TB2_PROXY_API_KEY",
      "service_api_key_header": "Authorization",
      "service_api_key_scheme": "Bearer",
      "sticky_header_name": "X-SMG-Routing-Key",
      "verify_tls": false
    },
    "environment": {
      "mode": "native"
    },
    "execution_mode": "training",
    "gateway": {
      "advertise_url": "http://host.docker.internal:35101",
      "limits": {
        "drain_timeout_sec": 180.0,
        "max_active_routes": 36,
        "max_inflight_global": 18,
        "max_inflight_per_route": 1,
        "max_tombstones": 4096,
        "queue_timeout_sec": 3900.0,
        "request_body_max_bytes": 33554432,
        "request_header_max_bytes": 65536,
        "route_ttl_sec": 14400.0,
        "sse_idle_timeout_sec": 3900.0,
        "tombstone_ttl_sec": 600.0
      },
      "listen_host": "0.0.0.0",
      "listen_port": 35101,
      "log_level": "warning"
    },
    "schema_version": "dressage.harbor/v1",
    "security": {
      "additional_agent_egress_hosts": [],
      "allow_model_listing": false,
      "require_tls_for_non_loopback": false,
      "routing_guarantee": "configure_only"
    },
    "training": {
      "failed_group_policy": "zero_grad",
      "group_max_retries": 0,
      "max_replacement_groups": 0,
      "min_live_group_ratio": 0.0,
      "model_override": "$MODEL",
      "replacement_exhausted_policy": "abort_batch",
      "require_single_weight_version": false,
      "reward_key": "reward",
      "sampling": {
        "mode": "force",
        "seed_policy": "per_attempt_request",
        "temperature": 1.0,
        "top_p": 1.0
      }
    },
    "trajectory": {
      "default_temperature": 1.0,
      "max_steps": 1024,
      "require_trainable_tokens": true
    }
  },
  "job": {
    "agents": [
      {
        "kwargs": {
          "model_auto_compact_token_limit": 196608,
          "model_catalog_json": "/etc/dressage/qwen38-codex-models.json",
          "model_context_window": 262144,
          "reasoning_effort": "xhigh",
          "reasoning_summary": "detailed",
          "version": "0.142.5",
          "web_search": "disabled"
        },
        "model_name": "$MODEL",
        "n_concurrent": 18,
        "name": "codex"
      }
    ],
    "environment": {
      "delete": true,
      "extra_docker_compose": [
        "$REMOTE_ROOT/runtime/host-gateway.compose.yaml"
      ],
      "force_build": false,
      "type": "docker"
    },
    "job_name": "quality-checkpoint",
    "jobs_dir": "$REMOTE_ROOT/jobs",
    "n_attempts": 1,
    "n_concurrent_trials": 18,
    "quiet": true,
    "retry": {
      "max_retries": 0
