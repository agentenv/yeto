{#- DeepSeek-V4-Flash-0731 chat template.
    Reverse-engineered from meta/encoding/encoding_dsv4.py (encode_messages), since the model
    does not ship a Jinja template. See findings.md for the derivation and known limitations
    (developer role, quick-instruction task tokens, wo_eos, multi-turn tool-result sorting for
    out-of-order tool_call_id are not implemented — internal-pipeline-only per the encoder's own
    README, not reachable through /v1/chat/completions). -#}
{%- set thinking_mode = thinking_mode | default('thinking') -%}
{%- set reasoning_effort = reasoning_effort | default('low') -%}
{%- set drop_thinking = drop_thinking | default(true) -%}

{%- set dsml = '｜DSML｜' -%}
{%- set think_open = '<think>' -%}
{%- set think_close = '</think>' -%}
{%- set bos = '<｜begin▁of▁sentence｜>' -%}
{%- set eos = '<｜end▁of▁sentence｜>' -%}

{%- set effort_prefix = {
    'low': '',
    'high': 'Reasoning Effort: Absolute maximum with no shortcuts permitted.\nYou MUST be very thorough in your thinking and comprehensively decompose the problem to resolve the root cause, rigorously stress-testing your logic against all potential paths, edge cases, and adversarial scenarios.\nExplicitly write out your entire deliberation process, documenting every intermediate step, considered alternative, and rejected hypothesis to ensure absolutely no assumption is left unchecked.\n\n',
    'max': 'Reasoning Effort: Beyond maximum — exhaustive, relentless, and uncompromising.\nYou MUST reason with the utmost depth and rigor, leaving absolutely nothing to chance: exhaustively decompose the problem into its most fundamental components, trace every causal chain to its root, and resolve the underlying cause rather than any surface symptom.\nDo not stop reasoning until you have independently verified the solution from multiple angles and are certain that no assumption remains unchecked and no error remains undiscovered.\n\n'
}[reasoning_effort] -%}

{%- set tools_header = '## Tools\n\nYou have access to a set of tools to help answer the user\'s question. You can invoke tools by writing a "<' + dsml + 'tool_calls>" block like the following:\n\n<' + dsml + 'tool_calls>\n<' + dsml + 'invoke name="$TOOL_NAME">\n<' + dsml + 'parameter name="$PARAMETER_NAME" string="true|false">$PARAMETER_VALUE</' + dsml + 'parameter>\n...\n</' + dsml + 'invoke>\n<' + dsml + 'invoke name="$TOOL_NAME2">\n...\n</' + dsml + 'invoke>\n</' + dsml + 'tool_calls>\n\nString parameters should be specified as is and set `string="true"`. For all other types (numbers, booleans, arrays, objects), pass the value in JSON format and set `string="false"`.\n\nIf thinking_mode is enabled (triggered by ' + think_open + '), you MUST output your complete reasoning inside ' + think_open + '...' + think_close + ' BEFORE any tool calls or final response.\n\nOtherwise, output directly after ' + think_close + ' with tool calls or final response.\n\n### Available Tool Schemas\n\n' -%}
{%- set tools_footer = '\nYou MUST strictly follow the above defined tool name and parameter schemas to invoke tool calls.\n' -%}

{#- last_user_idx: index of the last user/tool-result turn; any_tools: whether any message
    defines a `tools` schema (message-level, e.g. `developer` role) OR the top-level `tools`
    kwarg was passed (the real /v1/chat/completions wire-format path: OpenAI clients send
    `tools` as a top-level request field, not embedded in a message; vLLM's serving layer
    only preserves a message-level `tools` key for role=="developer", which is unreachable
    via the real API -- see findings.md). Either source forces full reasoning retention. -#}
{%- set ns = namespace(any_tools=false, last_user_idx=-1) -%}
{%- if tools is defined and tools -%}{%- set ns.any_tools = true -%}{%- endif -%}
{%- for m in messages -%}
    {%- if m.get('tools') -%}{%- set ns.any_tools = true -%}{%- endif -%}
    {%- if m['role'] in ['user', 'tool'] -%}{%- set ns.last_user_idx = loop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- set effective_drop_thinking = false if ns.any_tools else drop_thinking -%}

{{- bos -}}
{%- if thinking_mode == 'thinking' -%}{{- effort_prefix -}}{%- endif -%}

{%- macro render_tools_block(schema_list) -%}
    {%- set ts = namespace(schemas=[]) -%}
    {%- for tool in schema_list -%}
        {%- set ts.schemas = ts.schemas + [tool['function'] | tojson] -%}
    {%- endfor -%}
    {{- tools_header + ts.schemas | join('\n') + '\n' + tools_footer -}}
{%- endmacro -%}

{#- top-level `tools` (the real wire-format path -- see ns.any_tools comment above) attaches
    to the first message if it's a system message, otherwise a tools-only synthetic system
    turn is emitted first, matching vLLM's own native DeepSeek-V4 encoder behavior. -#}
{%- set state = namespace(in_user=false, tools_rendered=false) -%}
{%- if tools is defined and tools and not (messages and messages[0]['role'] == 'system') -%}
    {{- '\n\n' -}}{{- render_tools_block(tools) -}}
    {%- set state.tools_rendered = true -%}
{%- endif -%}
{%- for m in messages -%}
    {%- if m['role'] == 'system' -%}
        {{- m['content'] or '' -}}
        {%- set msg_tools = m.get('tools') or (tools if (loop.first and not state.tools_rendered and tools is defined and tools) else none) -%}
        {%- if msg_tools -%}
            {{- '\n\n' -}}{{- render_tools_block(msg_tools) -}}
            {%- set state.tools_rendered = true -%}
        {%- endif -%}
    {%- elif m['role'] in ['user', 'tool'] -%}
        {%- if state.in_user -%}
            {{- '\n\n' -}}
        {%- else -%}
            {{- '<｜User｜>' -}}
            {%- set state.in_user = true -%}
        {%- endif -%}
        {%- if m['role'] == 'tool' -%}
            {{- '<tool_result>' + (m['content'] or '') + '</tool_result>' -}}
        {%- else -%}
            {{- m['content'] or '' -}}
        {%- endif -%}
    {%- elif m['role'] == 'assistant' -%}
        {%- set state.in_user = false -%}
        {%- set retain_reasoning = (not effective_drop_thinking) or (loop.index0 > ns.last_user_idx) -%}
        {{- '<｜Assistant｜>' -}}
        {%- if thinking_mode == 'thinking' and retain_reasoning -%}
            {{- think_open + (m.get('reasoning_content') or '') + think_close -}}
        {%- else -%}
            {{- think_close -}}
        {%- endif -%}
        {{- m['content'] or '' -}}
        {%- if m.get('tool_calls') -%}
            {{- '\n\n<' + dsml + 'tool_calls>\n' -}}
            {%- for tc in m['tool_calls'] -%}
                {%- set func = tc['function'] -%}
                {{- '<' + dsml + 'invoke name="' + func['name'] + '">\n' -}}
                {#- func['arguments'] must already be a mapping here, not a JSON string: this
                    Jinja environment (transformers) only exposes a `tojson` filter, no
                    `from_json`/`fromjson` counterpart, so the caller (server-side request
                    handling) must parse OpenAI's wire-format arguments string into a dict
                    before building the messages list handed to apply_chat_template. -#}
                {%- set args = func['arguments'] -%}
                {%- for key, val in args.items() -%}
                    {%- if val is string -%}
                        {{- '<' + dsml + 'parameter name="' + key + '" string="true">' + val + '</' + dsml + 'parameter>\n' -}}
                    {%- else -%}
                        {{- '<' + dsml + 'parameter name="' + key + '" string="false">' + (val | tojson) + '</' + dsml + 'parameter>\n' -}}
                    {%- endif -%}
                {%- endfor -%}
                {{- '</' + dsml + 'invoke>\n' -}}
            {%- endfor -%}
            {{- '</' + dsml + 'tool_calls>' -}}
        {%- endif -%}
        {{- eos -}}
    {%- endif -%}
{%- endfor -%}

{%- if add_generation_prompt and messages[-1]['role'] in ['user', 'tool'] -%}
    {{- '<｜Assistant｜>' -}}
    {%- if thinking_mode == 'thinking' -%}
        {{- think_open -}}
    {%- else -%}
        {{- think_close -}}
    {%- endif -%}
{%- endif -%}
