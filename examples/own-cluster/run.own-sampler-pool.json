{
  "comment": "Own cluster as the sampler pool: two own 8 x H100 nodes run Qwen3-4B vLLM samplers (TP8) over SSH (provider.kind ssh, inventory.own-nodes.yaml, roles: [sampler]; the third node is the spare a lost node's slot moves to) for an async GRPO trainer on Modal (1 x 2 x H100). The pool starts each sampler through the unified node runtime, the ssh pool default (ready, heartbeats and exit in the run store). Own nodes bill nothing: the spend is the Modal trainer's. docs/OWN_CLUSTERS.md, 'Own sampler pools'. yeto run up --config THIS.json --dry-run (it checks over SSH that the sampler nodes reach the store and the registry), then without --dry-run.",
  "run": "<run>",
  "store": "s3://<bucket>/runs/<run>",
  "samplers": [
    {
      "name": "own-h100",
      "provider": {
        "kind": "ssh",
        "inventory": "<inventory.own-nodes.yaml>",
        "nodes": [
          "own-smp-0",
          "own-smp-1",
          "own-smp-2"
        ],
        "workdir": "/srv/yeto/<run>",
        "runtime": "container",
        "container": {
          "engine": "docker",
          "image": "<sampler-image>",
          "pull": "missing"
        },
        "preflight": {
          "min_free_gib": 50,
          "require_idle": true
        }
      },
      "target": 2,
      "slots": [
        0,
        1,
        2
      ],
      "shard_base": "<run>",
      "shard_limit": 8,
      "spec": "<sampler-spec.qwen3-4b-vllm-own-h100.json>",
      "run_prefix": "<run>",
      "r2_env_file": "<store.env>",
      "sampler": {
        "dispense": {
          "backend": "store",
          "namespace": "task-dispense"
        }
      }
    }
  ],
  "trainer": {
    "argv": [
      "--training-mode",
      "rl",
      "--gpu",
      "modal:1x2xh100",
      "--cluster-prefix",
      "<run>",
      "--model",
      "Qwen/Qwen3-4B",
      "--model-revision",
      "<model-revision>",
      "--data",
      "<prompts.jsonl>",
      "--reward-function",
      "yeto.rl.gsm8k_reward:score",
      "--trust-remote-code",
      "--tuning",
      "full",
      "--rl-sample-role",
      "trainer",
      "--rl-single-island-no-sync",
      "--controller",
      "local",
      "--rl-buffer-shards",
      "<run>-0,<run>-1,<run>-2,<run>-3,<run>-4,<run>-5,<run>-6,<run>-7",
      "--rl-checkpoint-store",
      "s3://<bucket>/runs/<run>",
      "--rl-object-store-endpoint",
      "<store-endpoint>",
      "--rl-algorithm-spec",
      "<algorithm-spec.async-age2-tis.json>",
      "--rl-max-policy-age",
      "2",
      "--rl-release-every",
      "2",
      "--rollout-batch-size",
      "16",
      "--n-samples-per-prompt",
      "8",
      "--rollout-max-response-len",
      "2048",
      "--seq-len",
      "4096",
      "--inner-lr",
      "1e-6",
      "--total-steps",
      "40"
    ],
    "usd_per_h": 8.0
  },
  "first_group": {
    "timeout_s": 4800,
    "poll_s": 60
  },
  "budget": {
    "usd": 60,
    "wall_h": 6,
    "nc_usd_per_h": 0
  }
}
