{
  "_comment": [
    "Engine sampler spec of one Qwen3-4B vLLM sampler on an own 8 x B300 node (TP8, bf16, in-place",
    "reload) of the SSH inventory pool in run.own-trainer-own-sampler.json: the container sees the",
    "pool's workdir and the inventory's mounts at their host paths; the weights are on the node",
    "(/data/models), the pool uploads its prompts_file to prompts.path at every start. The pool",
    "renders the store, shard and sampler id at start.",
    "docs/OWN_CLUSTERS.md."
  ],
  "sampler_id": "qwen3-4b-0",
  "platform": "cuda",
  "rollout_fields": {
    "top_logprobs_num": 0
  },
  "engine": {
    "factory": "yeto.rl.adapters.sampler_engines.from_spec:build",
    "adapter": "vllm-server",
    "server": {
      "base_dir": "/data/models/Qwen3-4B",
      "port": 30000,
      "card_model": "B300",
      "device_family": "cuda",
      "engine_version": "vllm@0.11.0",
      "precision": "bf16",
      "quant_scheme": "bf16",
      "topology": "tp8",
      "max_model_len": 8192,
      "in_place_reload": true,
      "start_timeout_s": 1800.0,
      "extra_args": []
    },
    "options": {
      "tp": 8,
      "max_num_seqs": 256
    }
  },
  "sampling": {
    "max_tokens": 2048,
    "temperature": 1.0,
    "top_p": 1.0,
    "top_k": -1,
    "n": 8
  },
  "num_rollouts": 1000000,
  "max_backlog_groups": "auto",
  "max_prompt_tokens": 1024,
  "store": "/srv/yeto/<run>/stage/<bucket>/runs/__RUN_PREFIX__",
  "prompts": {
    "path": "/data/models/prompts/gsm8k.jsonl",
    "input_key": "question",
    "label_key": "answer",
    "groups_per_round": 2,
    "format": "chat",
    "tokenizer": "/data/models/Qwen3-4B",
    "dispense": {
      "backend": "store",
      "namespace": "task-dispense"
    }
  },
  "reward": "yeto.rl.gsm8k_reward:score",
  "reward_kind": "miles",
  "checks": {
    "require_fixed_answers": false
  },
  "incarnation_lease": true,
  "event_tape": "/srv/yeto/<run>/sampler/events-__RUN_PREFIX__.jsonl"
}
