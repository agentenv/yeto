{
  "comment": "K3.1-Pro agentic async GRPO at 262k on a customer 6 x 8 B300 bare-metal trainer (SSH + Docker, inventory.b300-6x8-baremetal.yaml) with NC MI355X samplers (pool.nc-mi355x-agentic-262k.json). Runbook: docs/K31_BARE_METAL_B300.md. yeto run up --config THIS.json --dry-run, then without --dry-run.",
  "run": "<run>",
  "store": "s3://<bucket>/runs/<run>",
  "env": {
    "AWS_PROFILE": "<profile>",
    "YETO_RL_STORE_S3_PROFILE": "<store-profile>",
    "YETO_NC_ACCOUNTS": "<account-id>,<account-id>,<account-id>,<account-id>",
    "YETO_NC_STATE_DIR": "<nc-state-dir>",
    "NC_TOOL_DIR": "<nc-tool-dir>"
  },
  "sandbox": {
    "envs": "<envs.json>",
    "docker_host": "ssh://<sandbox-user>@<sandbox-host>",
    "max_run_containers": 80,
    "max_containers_per_sampler": 24
  },
  "pool": {
    "config": "<pool.nc-mi355x-agentic-262k.json>",
    "interval_s": 30
  },
  "trainer": {
    "argv": [
      "--training-mode",
      "rl",
      "--gpu",
      "ssh:6x8xb300",
      "--cluster-prefix",
      "<run>",
      "--rl-node-inventory",
      "<inventory.b300-6x8-baremetal.yaml>",
      "--rl-ssh-trainer-workdir",
      "/opt/yeto",
      "--rl-image",
      "docker:ghcr.io/agentenv/yeto-miles-k31@sha256:2de5d796de19d38f4e3165efce2a9528a7f7d3e60e3cb32fe29fd00c6abf9b5b",
      "--model",
      "moonshotai/Kimi-K3.1-Pro",
      "--model-revision",
      "<model-revision>",
      "--data",
      "<prompt-dataset>",
      "--data-revision",
      "<data-revision>",
      "--rl-prompt-column",
      "prompt",
      "--rl-label-column",
      "metadata",
      "--reward-function",
      "<module:function>",
      "--trust-remote-code",
      "--tuning",
      "full",
      "--rl-model-recipe",
      "kimi_k31",
      "--rl-expert-selection",
      "<expert_selection.ep16.json>",
      "--rl-routed-expert-qat",
      "mxfp4",
      "--expert-parallel",
      "16",
      "--tensor-parallel",
      "8",
      "--pipeline-parallel",
      "3",
      "--context-parallel",
      "2",
      "--rl-allow-cross-node-tp",
      "--rl-sample-role",
      "trainer",
      "--rl-single-island-no-sync",
      "--controller",
      "local",
      "--rl-buffer-shards",
      "<run>-0,<run>-1,<run>-2,<run>-3,<run>-4,<run>-5,<run>-6,<run>-7,<run>-8,<run>-9,<run>-10,<run>-11,<run>-12,<run>-13,<run>-14,<run>-15",
      "--rl-stall-timeout",
      "7200",
      "--idle-warn-minutes",
      "0",
      "--rl-checkpoint-store",
      "s3://<bucket>/runs/<run>",
      "--rl-object-store-endpoint",
      "<store-endpoint>",
      "--rl-round-cuts",
      "off",
      "--inner-lr",
      "1e-4",
      "--rl-lr-schedule",
      "constant",
      "--rl-max-policy-age",
      "12",
      "--rl-algorithm-spec",
      "<algorithm-spec.async-age12.json>",
      "--rl-release-every",
      "6",
      "--rl-release-skip-busy",
      "--rl-loss",
      "score_centering",
      "--rl-score-centering-is",
      "tis",
      "--rl-score-centering-tis-clip",
      "2.0",
      "--rl-rollout-top-logprobs-num",
      "128",
      "--rl-allow-unverified-mechanism",
      "losses:score_centering",
      "--rl-allow-unverified-mechanism",
      "features:rollout_logprobs_as_old",
      "--rl-allow-unverified-mechanism",
      "features:no_grpo_std_normalization",
      "--rl-allow-unverified-mechanism",
      "loss_aggregations:token",
      "--rollout-batch-size",
      "8",
      "--n-samples-per-prompt",
      "8",
      "--rollout-max-response-len",
      "245760",
      "--seq-len",
      "262144",
      "--rl-activation-recompute",
      "--rl-max-tokens-per-gpu",
      "131072",
      "--rl-distributed-timeout-minutes",
      "60",
      "--rl-optimizer-offload-fraction",
      "1.0",
      "--rl-island-ray-spill-dir",
      "/root/.cache/ray-spill",
      "--total-steps",
      "<total-steps>"
    ],
    "usd_per_h": 0,
    "progress_paths": []
  },
  "first_group": {
    "timeout_s": 10800,
    "poll_s": 60
  },
  "dashboard": {
    "port": 8795
  },
  "budget": {
    "usd": 20000,
    "wall_h": 72,
    "nc_usd_per_h": 24,
    "silence_min": 120,
    "release_nc_on_breach": false,
    "release_nc_on_finish": true
  }
}
