{
  "comment": "K3.1-Pro agentic 262k: NC MI355X sampler pool (spec sampler-spec.nc-mi355x-vllm-agentic-262k.json). List more accounts than target: a node lives 4 h and its replacement is ordered on another account replace_lead_s before the lease ends.",
  "run": "<run>",
  "route": "ssh",
  "target": 2,
  "accounts": ["<account-id>", "<account-id>", "<account-id>", "<account-id>"],
  "shard_base": "<run>",
  "shard_limit": 16,
  "machine_type": "mi355x",
  "spec": "<sampler-spec.nc-mi355x-vllm-agentic-262k.json>",
  "run_prefix": "<run>",
  "r2_env_file": "<store-env-file>",
  "agentic_env_file": "<agentic-env-file>",
  "model_pull": {"src_key": "<models/prefix of Kimi-K3.1-Pro>", "max_mb_s": 2500, "timeout_s": 7200},
  "replace_lead_s": 3600,
  "end_margin_s": 600,
  "sampler": {
    "dispense": {
      "backend": "store",
      "namespace": "<run>/task-dispense",
      "lease_s": 900,
      "max_redo": 2,
      "passes": 1,
      "seed": 1
    }
  },
  "node_hooks": [
    {
      "name": "prompts",
      "where": "local",
      "timeout_s": 300,
      "command": "ssh -n -o BatchMode=yes {alias} 'mkdir -p /mnt/nvme/work/sampler' && scp -q -o BatchMode=yes <prompts.jsonl> {alias}:/mnt/nvme/work/sampler/prompts.jsonl"
    }
  ],
  "elastic": {
    "max_nodes": 4,
    "max_orders": 20,
    "start_timeout_s": 5400,
    "max_sampler_restarts": 2,
    "engine_stall_s": 900,
    "max_run_spend_ucr": 3000000000
  }
}
