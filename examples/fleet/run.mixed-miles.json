{
  "comment": "Island fleet with a Miles sampler island and an external pool in one island: island 0 is a 2xH100 Miles trainer with a Modal vLLM pool; island 1 is a 2xH100 Miles trainer with a Miles sampler island (launch island 2, SGLang on one L40S) and a Modal SGLang pool. Qwen3-4B, full parameters, decoupled, one syncer. dispense fleet: the Miles sampler and both pools claim their prompts from one task ledger (fleet/dispense of the run store), so --data is the pools' prompt file (the same JSONL as the specs' prompts.path). docs/MILES_RL.md, 'Island fleet'. yeto run up --config THIS.json --dry-run, then without --dry-run.",
  "run": "<run>",
  "store": "s3://<bucket>/runs/<run>",
  "budget": {"usd": 40, "wall_h": 4, "nc_usd_per_h": 0},
  "first_group": {"timeout_s": 4800, "poll_s": 60},
  "fleet": {
    "dispense": "fleet",
    "trainer_argv": [
      "--training-mode", "rl",
      "--cluster-prefix", "<run>",
      "--model", "Qwen/Qwen3-4B",
      "--data", "<prompts.jsonl>",
      "--rl-prompt-column", "q",
      "--rl-label-column", "a",
      "--reward-function", "yeto.rl.gsm8k_reward:score",
      "--trust-remote-code",
      "--tuning", "full",
      "--rl-sync-preset", "decoupled",
      "--fragments", "4",
      "--rl-parameter-layout-sha256", "auto",
      "--local-rl-rounds-per-sync", "4",
      "--rl-max-policy-age", "2",
      "--rl-algorithm-spec", "examples/k31/algorithm-spec.async-age2-tis.json",
      "--rollout-batch-size", "16",
      "--n-samples-per-prompt", "8",
      "--rollout-max-response-len", "2048",
      "--seq-len", "4096",
      "--inner-lr", "1e-6",
      "--total-steps", "40",
      "--rl-stall-timeout", "1800",
      "--rl-checkpoint-store", "s3://<bucket>/runs/<run>"
    ]
  },
  "islands": [
    {
      "name": "vllm",
      "trainer": {"gpu": "modal:1x2xh100", "usd_per_h": 8.0},
      "samplers": [
        {"name": "vllm-h100",
         "provider": {"kind": "modal", "image": "<sampler-image>", "secret": "<modal-secret>", "bucket": "<bucket>",
                      "gpu": "H100", "gpus": 1, "model_volume": "<volume>"},
         "usd_per_h": 4.0, "target": 1, "slots": [1, 2], "shard_base": "<run>-vllm", "shard_limit": 4,
         "spec": "<sampler-spec.vllm.json>", "run_prefix": "<run>", "r2_env_file": "<store.env>",
         "sampler": {"dispense": {"backend": "store", "namespace": "task-dispense"}}}
      ]
    },
    {
      "name": "mixed",
      "trainer": {"gpu": "modal:1x2xh100", "usd_per_h": 8.0},
      "samplers": [
        {"kind": "miles", "name": "miles-l40s", "gpu": "modal:1x1xl40s", "usd_per_h": 2.0},
        {"name": "sglang-l40s",
         "provider": {"kind": "modal", "image": "<sampler-image>", "secret": "<modal-secret>", "bucket": "<bucket>",
                      "gpu": "L40S", "gpus": 1, "model_volume": "<volume>"},
         "usd_per_h": 2.0, "target": 1, "slots": [1, 2], "shard_base": "<run>-sglang", "shard_limit": 4,
         "spec": "<sampler-spec.sglang.json>", "run_prefix": "<run>", "r2_env_file": "<store.env>",
         "sampler": {"dispense": {"backend": "store", "namespace": "task-dispense"}}}
      ]
    }
  ]
}
