{
 "about": "WorkContract conformance cases (yeto/rl/engine/work_contract.py). Run by tests/test_work_contract.py (store ledger) and syncer/src/work_contract.rs (syncer dispenser). Members are 'holder#incarnation'. Items are slots / positions (one plain stream, seed 0). 'claim' expects {'items': [...]} (compared as a set), 'wait', 'end' or 'fenced'; 'done' / 'drop' / 'fail' / 'release' expect 'ok' or 'not_held'; 'join' and 'retire' expect the number of open claims released; 'holds' a boolean; 'totals' item counts. 'advance' moves the one clock by seconds. 'drain' / 'undrain' are the scale-down that keeps work in flight (no new claim, the held items finish); 'drained' expects whether the member has confirmed it holds nothing under the drain.",
 "version": 1,
 "cases": [
  {
   "name": "claim_done_and_data_end",
   "why": "items go out once; END only once every item is settled and none is held",
   "config": {
    "rows": 3,
    "passes": 1,
    "max_redo": 1,
    "lease_s": 60
   },
   "steps": [
    {
     "op": "join",
     "m": "A#1",
     "expect": 0
    },
    {
     "op": "join",
     "m": "B#1",
     "expect": 0
    },
    {
     "op": "claim",
     "m": "A#1",
     "n": 2,
     "expect": {
      "items": [
       0,
       1
      ]
     }
    },
    {
     "op": "done",
     "m": "A#1",
     "items": [
      0,
      1
     ],
     "expect": "ok"
    },
    {
     "op": "claim",
     "m": "A#1",
     "n": 2,
     "expect": {
      "items": [
       2
      ]
     }
    },
    {
     "op": "claim",
     "m": "B#1",
     "n": 1,
     "expect": "wait"
    },
    {
     "op": "done",
     "m": "A#1",
     "items": [
      2
     ],
     "expect": "ok"
    },
    {
     "op": "claim",
     "m": "B#1",
     "n": 1,
     "expect": "end"
    },
    {
     "op": "claim",
     "m": "A#1",
     "n": 1,
     "expect": "end"
    },
    {
     "op": "totals",
     "expect": {
      "trained": 3,
      "dropped": 0,
      "exhausted": 0
     }
    }
   ]
  },
